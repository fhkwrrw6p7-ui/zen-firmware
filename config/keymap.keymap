#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB        &kp Q           &kp W                 &kp E  &kp R       &kp T      &kp Y           &kp U           &kp I  &kp O           &kp P           &kp BSPC
&kp CAPSLOCK   &kp A           &kp S                 &kp D  &kp F       &kp G      &kp H           &kp J           &kp K  &kp L           &kp MINUS       &kp ENTER
&kp LS(LSHFT)  &kp Z           &kp X                 &kp C  &kp V       &kp B      &kp LANGUAGE_2  &kp LANGUAGE_1  &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &kp SLASH
&kp LC(LCTRL)  &kp LG(ESCAPE)  &kp LA(LEFT_CONTROL)  &mo 2  &kp DELETE  &kp SPACE  &kp SPACE       &kp SPACE       &mo 3  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &mkp LCLK  &mo 4             &mkp RCLK  &trans                 &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp RG(LEFT_BRACKET)  &mkp MB1   &mkp MB3          &mkp MB2   &kp RG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &kp LC(UP_ARROW)  &trans     &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &trans            &trans     &trans                 &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &trans    &kp UP    &trans     &kp PAGE_UP    &kp HOME  &trans  &trans  &kp N7  &kp N8      &kp N9  &kp DELETE
&trans      &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN  &kp END   &trans  &trans  &kp N4  &kp N5      &kp N6  &trans
&trans      &trans    &trans    &trans     &trans         &trans    &trans  &trans  &trans  &trans      &kp N1  &kp N2      &kp N3  &kp MINUS
&trans      &trans    &trans    &trans     &trans         &trans    &trans  &trans  &kp N0  &kp PERIOD  &trans  &kp PLUS
            >;
        };

        layer_3 {
            bindings = <
&trans        &trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &trans   &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&bt BT_SEL 0  &trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &kp SQT  &kp DOLLAR      &kp PERCENT      &kp LCTRL             &trans
&bt BT_SEL 1  &trans  &trans  &kp F4   &kp F5   &kp F6   &trans  &trans   &trans          &kp SEMICOLON    &kp EXCLAMATION       &kp AT_SIGN            &kp POUND  &trans
&bt BT_SEL 2  &trans  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans   &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans                &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
